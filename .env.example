# Copy this file to .env and fill in your values. .env is ignored by git.

# Base URL of your Home Assistant instance (no trailing slash)
HA_URL=http://homeassistant.local:8123

# Long-lived access token: Home Assistant -> your profile -> Security -> Long-lived access tokens
HA_TOKEN=

# Optional defaults for `ha-why night`
# Entity whose state is the room you are in (input_select or sensor)
HA_WHY_ROOM_ENTITY=
# Night window in hours, e.g. 0-6 or 22-6
HA_WHY_NIGHT_WINDOW=0-6
# Pulses a sensor needs before it is listed
HA_WHY_MIN_PULSES=5
# Regex of entity ids or names to ignore, e.g. zone|grow_tent
HA_WHY_EXCLUDE=
